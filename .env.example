NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side transactional email. Use resend locally or brevo in production.
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME="First ID PH"
RESEND_API_KEY=
BREVO_API_KEY=

# Server-only account administration. APP_URL is the trusted invite destination.
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000

# Published on the consultation privacy notice. Set to the actual controller,
# monitored privacy contact, and retention policy before accepting real requests.
CONSULTATION_PRIVACY_CONTROLLER=
CONSULTATION_PRIVACY_EMAIL=
CONSULTATION_PRIVACY_RETENTION=

# Enable a public demo that stores fictional consultation details.
CONSULTATION_DEMO_MODE=false
